#### SQL ####

## SQL is a language used to talk to databases. Think of a database like a giant excel spreadsheet w/ multiple tables.
# Instead of opening Excel and scrolling. You write a SQL command to get exactly what you want.

# SQL Data imports 
import sqlite3 as sq3
import pandas as pd

# Initialize path to SQLite database
path = 'data/classic_rock.db'

# Create connection SQL database
con = sq3.Connection(path)

# Write Query
query = ''' SELECT * FROM rock_songs; 
'''

# Means Give me ALL columns and ALL rows from the rock_songs table.

# Execute Query
data = pd.read_sql(query, con)  # -> Returns result as a dataframe.




